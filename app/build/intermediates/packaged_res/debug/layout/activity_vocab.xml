<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Nav -->

    <!-- Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/orange"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="58dp"
            android:layout_height="66dp"
            android:layout_marginEnd="12dp"
            android:background="#00000000"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="⬅️"
            android:textColor="@color/bg"
            android:textSize="20sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📖 Kosakata"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 kata"
            android:textColor="#FFE0BC"
            android:textSize="13sp" />
    </LinearLayout>

    <SearchView android:id="@+id/svSearch"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:queryHint="🔍  Cari kata..." android:background="@color/white"
        android:padding="4dp" />

    <!-- Category chips -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:background="@color/white" android:paddingBottom="8dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/cgCategories"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            app:singleSelection="true" app:selectionRequired="true" />
    </HorizontalScrollView>

    <!-- Grid -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvVocab"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="12dp" android:clipToPadding="false" />

</LinearLayout>
