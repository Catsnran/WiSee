<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <!-- Header Logo -->
        <ImageView
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_wisee_logo"
            android:scaleType="fitCenter"
            android:contentDescription="WiSee" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Buat akun dan mulai belajar bersama!"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- Card Form -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/WiSeeCard"
            android:layout_marginBottom="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Nama -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="😊  Nama Lengkap" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Nama kamu..."
                    android:inputType="textPersonName" android:background="@drawable/input_bg"
                    android:padding="14dp" android:textSize="14sp"
                    android:layout_marginBottom="14dp" android:singleLine="true" />

                <!-- Username -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="👤  Username" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etUsername" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Username unik kamu..."
                    android:inputType="text" android:background="@drawable/input_bg"
                    android:padding="14dp" android:textSize="14sp"
                    android:layout_marginBottom="14dp" android:singleLine="true" />

                <!-- Email -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📧  Email" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etEmail" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Email kamu..."
                    android:inputType="textEmailAddress" android:background="@drawable/input_bg"
                    android:padding="14dp" android:textSize="14sp"
                    android:layout_marginBottom="14dp" android:singleLine="true" />

                <!-- Password -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔒  Password" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etPassword" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Minimal 6 karakter..."
                    android:inputType="textPassword" android:background="@drawable/input_bg"
                    android:padding="14dp" android:textSize="14sp"
                    android:layout_marginBottom="14dp" android:singleLine="true" />

                <!-- Konfirmasi -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔐  Konfirmasi Password" android:textColor="@color/text_secondary"
                    android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etConfirm" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Ulangi password..."
                    android:inputType="textPassword" android:background="@drawable/input_bg"
                    android:padding="14dp" android:textSize="14sp"
                    android:layout_marginBottom="12dp" android:singleLine="true"
                    android:imeOptions="actionDone" />

                <!-- Error / Success -->
                <TextView android:id="@+id/tvError" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text=""
                    android:textColor="@color/danger" android:textSize="13sp" android:textStyle="bold"
                    android:background="@drawable/error_bg" android:padding="10dp"
                    android:layout_marginBottom="8dp" android:visibility="gone" />
                <TextView android:id="@+id/tvSuccess" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text=""
                    android:textColor="@color/success" android:textSize="13sp" android:textStyle="bold"
                    android:background="@drawable/success_bg" android:padding="10dp"
                    android:layout_marginBottom="8dp" android:visibility="gone" />

                <!-- Register Button -->
                <Button android:id="@+id/btnRegister" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="🌈  Daftar Sekarang!"
                    style="@style/WiSeeButton.Primary" android:layout_marginBottom="16dp"
                    android:layout_marginTop="4dp" />

                <!-- Go Login -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Sudah punya akun? " android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                    <TextView android:id="@+id/tvGoLogin" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Masuk di sini →"
                        android:textColor="@color/blue" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
